[Unit]
Description=Workspace Agent — Edge AI Room Monitor
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/workspace-agent
ExecStart=/usr/bin/python3 /home/pi/workspace-agent/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
